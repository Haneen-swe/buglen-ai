# BugLens AI environment variables
# Copy this file to .env.local and fill in real values. NEVER commit real keys.

# API key for the AI provider (server-side only; never prefixed with NEXT_PUBLIC_)
AI_API_KEY=

# Optional: model name and API base URL (defaults target the Anthropic Messages API)
AI_MODEL=claude-sonnet-4-5
AI_API_URL=https://api.anthropic.com/v1/messages

# Optional: limits
MAX_CODE_CHARS=12000
RATE_LIMIT_PER_MINUTE=10
